BLOG_ADMIN_HOST=127.0.0.1
BLOG_ADMIN_PORT=18080
BLOG_ADMIN_USER=admin
BLOG_ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-generated-salt$replace-with-generated-hash
BLOG_ADMIN_SESSION_SECRET=replace-with-at-least-48-random-bytes
BLOG_ADMIN_ANALYTICS_SECRET=replace-with-a-different-random-secret
BLOG_ADMIN_ALLOWED_ORIGINS=https://shcxyz.site,https://www.shcxyz.site
BLOG_ADMIN_SOURCE_DIR=/www/wwwroot/blog-admin-source
BLOG_ADMIN_REPO_URL=git@github.com-vistar-blog-admin:achen919/vistar.git
BLOG_ADMIN_BRANCH=main
BLOG_ADMIN_SSH_KEY=/var/lib/blog-admin/.ssh/vistar_blog_admin_ed25519
BLOG_ADMIN_UPDATE_SUBMODULES=0
BLOG_ADMIN_ACCESS_LOG=/www/wwwlogs/blog.log
BLOG_ADMIN_STATS_CACHE_SECONDS=60
BLOG_ADMIN_TIMEZONE=Asia/Shanghai
BLOG_ADMIN_AUDIT_LOG=/var/lib/blog-admin/audit.log
BLOG_ADMIN_REVOCATION_FILE=/var/lib/blog-admin/revoked-sessions.jsonl
